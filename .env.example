# ========================================================
# TataDana Environment Variables Configuration
# ========================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN="your-telegram-bot-token-from-botfather"
WEBHOOK_BASE_URL="http://localhost:3000"

# AI Engine Providers (Gemini default, OpenAI & DeepSeek failover/custom)
GEMINI_API_KEY="your-google-gemini-api-key"
OPENAI_API_KEY="your-openai-api-key"
DEEPSEEK_API_KEY="your-deepseek-api-key"

# Supabase (PostgreSQL & Storage)
# TataDana menyertakan reliable local fallback sehingga aplikasi 100% fungsional
# meskipun kredensial live Supabase belum diisi.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="tatadana-exports"

# Payment Gateway (Midtrans)
MIDTRANS_SERVER_KEY="SB-Mid-server-your-key"
MIDTRANS_CLIENT_KEY="SB-Mid-client-your-key"
MIDTRANS_IS_PRODUCTION="false"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TIMEZONE="Asia/Jakarta"
