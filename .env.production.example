# ============================================================
# TATA DANA FINTECH - PRODUCTION ENVIRONMENT VARIABLES (SUMOPOD)
# ============================================================

# 1. Telegram Bot (Gunakan token bot resmi Anda)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# 2. Public Webhook URL (Ganti dengan domain atau URL publik SumoPod/Vercel Anda)
# Contoh: https://tatadana.vercel.app atau https://domainanda.com
WEBHOOK_BASE_URL="https://YOUR_DOMAIN_OR_VERCEL_URL"
NEXT_PUBLIC_APP_URL="https://YOUR_DOMAIN_OR_VERCEL_URL"

# 3. Supabase Live Database & Storage
SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"
SUPABASE_STORAGE_BUCKET="tatadana-exports"

# 4. AI Provider Key (Opsional - default menggunakan built-in rule engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""

# 5. Konfigurasi Sistem
TIMEZONE="Asia/Jakarta"
NODE_ENV="production"
PORT=3000
